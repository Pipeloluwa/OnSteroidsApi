{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AppSettings": {
    "AllowedHosts": "*",
    "AllowedOrigins": "*",
    "LogSettings": {
      "LogDirectory": "Logs",
      "Console": {
        "Enabled": true,
        "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{RequestId}] {Message:lj}{NewLine}{Exception}"
      },
      "Structured": {
        "Enabled": true,
        "Folder": "Structured",
        "FileName": "log-.json",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 31,
        "FileSizeLimitBytes": 104857600,
        "RollOnFileSizeLimit": true
      },
      "Unstructured": {
        "Enabled": true,
        "Folder": "Unstructured",
        "FileName": "log-.txt",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 31,
        "FileSizeLimitBytes": 104857600,
        "RollOnFileSizeLimit": true,
        "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{RequestId}] {Message:lj}{NewLine}{Exception}"
      },
      "Database": {
        "Enabled": true,
        "StoredProcedure": "spApiLogs_Insert"
      }
    },
    "SqlSettings": {
      "ConnectionString": "Server=YOUR_SERVER;Database=OnSteroids;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
    },
    "GlobalRateLimiter": {
      "PermitLimit": 300,
      "WindowMinutes": 1,
      "QueueLimit": 2,
      "ErrorMessage": "Too many requests. Please try again after {retryAfterMinutes} minute(s)."
    }
  }
}
