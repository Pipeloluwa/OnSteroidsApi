{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AppSettings": {
    "AllowedHosts": "*",
    "AllowedOrigins": "*",
    "LogSettings": {
      "LogDirectory": "Logs",
      "Console": {
        "Enabled": true,
        "OutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{RequestId}] {Message:lj}{NewLine}{Exception}"
      },
      "Structured": {
        "Enabled": true,
        "Folder": "Structured",
        "FileName": "log-.json",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 31,
        "FileSizeLimitBytes": 104857600,
        "RollOnFileSizeLimit": true
      },
      "Unstructured": {
        "Enabled": true,
        "Folder": "Unstructured",
        "FileName": "log-.txt",
        "RollingInterval": "Day",
        "RetainedFileCountLimit": 31,
        "FileSizeLimitBytes": 104857600,
        "RollOnFileSizeLimit": true,
        "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [{RequestId}] {Message:lj}{NewLine}{Exception}"
      },
      "Database": {
        "Enabled": true,
        "StoredProcedure": "spApiLogs_Insert"
      }
    },
    "SqlSettings": {
      //"ConnectionString": "Data Source=DESKTOP-3NDEL8H\\SQLEXPRESS;Database=OnSteroids;Integrated Security=True;Connect Timeout=30;Encrypt=True;Trusted_connection=true;TrustServerCertificate=true;Application Intent=ReadWrite;Multi Subnet Failover=False",
      "ConnectionString": "Server=db69979.databaseasp.net; Database=db69979; User Id=db69979; Password=5r+Nb#J9Wi3!; Encrypt=False; MultipleActiveResultSets=True;"
    },
    "GlobalRateLimiter": {
      "PermitLimit": 300,
      "WindowMinutes": 1,
      "QueueLimit": 2,
      "ErrorMessage": "Too many requests. Please try again after {retryAfterMinutes} minute(s)."
    }
    //"AllowedHosts": "https://www.proxy.onsteroid.com",
    //"AllowedOrigins": "https://www.onsteroid.com"
  }
}
